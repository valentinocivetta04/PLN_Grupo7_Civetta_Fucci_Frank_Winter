# Plantilla de configuración para las Partes E y F del TP2 (Supabase + pgvector).
# 1. Copiá este archivo como .env en la raíz del repo:  cp .env.example .env
# 2. Reemplazá <PEDIR_AL_GRUPO> por la contraseña (se comparte por privado, nunca por git).
SUPABASE_DB_URL=postgresql://tp2_app.aivkgxkmczikainfllgd:<PEDIR_AL_GRUPO>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Parte avanzada (RAG): key personal de NVIDIA NIM (build.nvidia.com). Cada integrante usa la suya.
NVIDIA_API_KEY=<TU_KEY_DE_NVIDIA_NIM>
